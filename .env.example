# Public app configuration
NEXT_PUBLIC_SITE_URL=https://project-you-plus.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access. Use the modern sb_secret_ key when available.
# Never expose this value to the browser.
SUPABASE_SECRET_KEY=
# Legacy fallback only if your project has not migrated yet:
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (free API, read-only in V10)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Plaid Sandbox (free development environment)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions

# OpenAI provider used by Coach and marketing agents
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_SMART_MODEL=gpt-5.6-terra

# Higgsfield Cloud. API key ID/secret and the account-specific video endpoint are
# entered securely from Owner > Integrations and stored server-side.
# The image endpoint below is the documented Higgsfield Soul quickstart endpoint.
HIGGSFIELD_IMAGE_MODEL_PATH=/higgsfield-ai/soul/v2/standard
# Optional server override only if you know the exact text-to-video endpoint enabled
# on this Higgsfield Cloud account. Otherwise configure it in Owner > Integrations.
HIGGSFIELD_VIDEO_MODEL_PATH=

# Optional backup AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
