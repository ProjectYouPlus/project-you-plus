# Public app configuration
NEXT_PUBLIC_SITE_URL=https://project-you-plus.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (free API, read-only in V10)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Plaid Sandbox (free development environment)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional cloud AI. Leave blank until you want usage-based AI billing.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_SMART_MODEL=gpt-5.6-terra

# Optional backup AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
